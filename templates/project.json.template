{
  "pipeline": "project-hero",
  "created": "<YYYY-MM-DD>",
  "course": {
    "board": "<Board, e.g. Edexcel>",
    "qualification": "<Qualification, e.g. IAL>",
    "subject": "<Subject, e.g. Physics>",
    "subject_slug": "<lowercase tag for frontmatter, e.g. physics>",
    "spec_code": "<board spec code, e.g. 1PH0>",
    "name": "<Board Qualification Subject>",
    "cobalt_course_id": "crs_...",
    "papers": [
      "<paper code = name, e.g. 'H432/01 = Periodic table, elements and physical chemistry', plus which sections/topics it covers — captured at /hero-0-setup §1>"
    ],
    "levels": "<level designations, e.g. 'Sections 2-4 = AS, 5-6 = A Level only' / 'Foundation/Higher' / 'Core/Extended' — captured at /hero-0-setup §1>",
    "tier_source": "<WHERE per-SP tier/level facts come from, named explicitly (F59): the converted spec CANNOT carry them (bold marking does not survive docling), so name the machine-readable source — e.g. 'tracker col 5 Higher Tier Only, adjudicated at the spec PDF font spans'. No writer should have to rediscover this>"
  },
  "paths": {
    "project_dir": "<absolute path to this project directory>",
    "vault_notes": "<LEGACY — absolute path to a pre-existing per-SP vault, only where /hero-1-research's adoption path is used; null on fresh builds>",
    "skills_map": "<path to skills-map.json — per-SP skills mapping read DIRECTLY from the specification at /hero-0-setup §7 (never via NotebookLM); null only with an explicit dated ruling>",
    "corpus_root": "<absolute path to the past-paper corpus — source PDFs verified on disk at /hero-0-setup §3, converted .md per sitting from §5>",
    "specification_pdf": "<absolute path to the specification PDF itself (F60) — the paths block names the corpus and tracker but the spec PDF is what tier spans and coverage gates must open; never make a gate glob for it>",
    "board_conventions": "<absolute path to the board marking-conventions extraction — built once per course with prompts/BOARD-CONVENTIONS.md as the CLOSING act of wave 1's /hero-1-research (F29/F31: producer at the research exit, wave 1 only; /hero-2-write only ASSERTS the path and refuses to launch writers while it is null>",
    "cobalt_structure": "cobalt-structure.json",
    "syllabus_cross_check": "<path to the downloaded tracker CSV used for the §2 cross-check (CSV preferred; G-sheet URL if that's what was used); null with a dated ruling in structure.cross_check_findings when the course has no Master Syllabus — ratification then runs from the Cobalt tree alone. This file is LOAD-BEARING, not documentation (F59): it is the independent statement of what the course must contain, and the spec-completeness gate diffs the converted spec against it. TRAP (F59): tracker tabs can carry TWO independent, non-row-aligned syllabus blocks — the subtopic-keyed definition column is authoritative; any abridged second listing is not (1PH0: the second block's 12.4 was a byte-identical duplicate of its 12.3, silently losing the real 12.4). Name which columns are authoritative when recording the path>",
    "cobalt_content": "<path to the extracted Cobalt commentary/ET&T file — extraction kicked off at /hero-0-setup §6; null only with an explicit dated ruling, never a silent deferral>",
    "sp_mapping": "sp-mapping.json",
    "manifest": "upload-manifest.json",
    "prompts": "prompts",
    "scripts": "scripts",
    "knowledge_files": "knowledge-files",
    "research": "research"
  },
  "structure": {
    "ratified": "<YYYY-MM-DD the user ratified the structure at /hero-0-setup §2 (the Cobalt-tree/tracker diff where a tracker exists, the Cobalt tree alone otherwise) — null means DO NOT BUILD>",
    "cross_check_findings": [
      "<each discrepancy + the user's ruling, e.g. '3 video-placeholder SPs in Cobalt, not in tracker -> no_content'>"
    ],
    "no_content_sp_ids": [
      "<spcpt_... ids ruled content-free — nothing written for them, writers/checkers treat as correctly empty>"
    ]
  },
  "corpus": {
    "kind": "<local | notebook | mixed — what the corpus physically is; a converted local QP/MS corpus is required before /hero-1-research in every research mode>",
    "unit_dir_pattern": "<how unit/paper subdirectories are named, e.g. 'Unit <N>'>",
    "file_naming": "<per-sitting file naming, e.g. '<YYYY> <Mon> - Question paper.md / - Mark scheme.md / - Examiner report.md'>",
    "sitting_variants": "<how resit/variant sittings are marked, e.g. '(A)'-suffixed sittings are separate files>",
    "notebook_id": "<NotebookLM notebook id — verified with notebook_get at /hero-0-setup §4; read by hybrid/nlm research modes>",
    "notebook_disk_gap": "<the /hero-0-setup §4 diff of notebook sources vs disk corpus (F16): sources with no disk counterpart and disk files with no notebook source. R2 reads disk only — a notebook-only sitting is invisible to research>",
    "conversion": {
      "status": "<pending | running | complete — kicked off at /hero-0-setup §5 via scripts/convert_pdfs.py; /hero-1-research gates on complete>",
      "engine": "<converter(s) that produced the corpus, PER DOCUMENT TYPE (F64) — e.g. 'docling for QP/MS/ER, pymupdf4llm for the specification (convert_pdfs.py)'. Engine choice is per document type, never per corpus: the docling-vs-pymupdf4llm result INVERTS between mark schemes and question papers. A text-layer extractor is NOT acceptable for mark schemes — see F17. Any engine deviation note must state WHAT the benchmark tested (F64: a rejection benchmarked on mark schemes was generalised to all three types)>",
      "table_gate_passed": null,
      "table_gate_notes": "<date of the last passing run + mark-scheme count checked; from conversion-report.json at the corpus root. 'Passing' now means table + legibility (F32) + spec bold (F44) gates together. status may not be 'complete' while this is false>",
      "notes": "<repair passes owed, sittings still outstanding>"
    },
    "second_engine_pass": "<F64 — where the benchmark shows neither engine dominates a doc type (typical for question papers: docling loses figure-internal text), record the second-engine extraction here: script, output dir (a PARALLEL tree, e.g. research/corpus/pdf-second-engine/, so nothing globbing *.md sees two files per paper), the measurements, and when consulting it is mandatory. The second extraction is EVIDENCE for absence-claims, never the citable corpus>",
    "known_casualties": [
      "<unusable FILES — never cite. Local corpus: file paths (mojibake, lost tables, glyph-index legibility failures from conversion-report.json — record those WITH the reason, F32). Notebook corpus: source titles (missing/duplicate sources, or variants such as 'Revised Mark Scheme' replacing 'Mark Scheme'). Keep this list current as waves discover more>"
    ],
    "content_limitations": [
      {
        "_comment": "F65 — the OTHER channel of corpus doubt: not 'which files are unusable' (known_casualties) but 'which KINDS of content are unreliable in every file'. Stage 0 once recorded exactly such a limitation (figure-internal text absent from converted markdown) in a free-text field nothing reads, and it shipped a defect five stages later. Every entry here is READ by R2/R3/WRITER/CHECKER alongside known_casualties, and /hero-4-publish BLOCKS while an entry has no mitigation recorded in the wave-state file.",
        "class": "<e.g. 'text rendered inside figures'>",
        "consequence": "<e.g. 'absent from converted markdown with no gap left behind'>",
        "applies_to": "<e.g. 'all question papers'>",
        "mandatory_action": "<e.g. 'check research/corpus/pdf-second-engine/ before any absence claim'>"
      }
    ]
  },
  "vault": {
    "_comment": "LEGACY block — present only where a pre-existing per-SP vault was adopted at /hero-1-research. Fresh builds omit this block entirely: there is no vault stage.",
    "status": "<adopted — the only valid value>",
    "adopted_coverage_profile": "<which of R1's nine sections the notes carry, and the declared research debt>"
  },
  "template": {
    "exam_skeleton": [
      "<one entry per H4 in the per-SP exam section, ratified at the /hero-1-research entry gate — copy NOTHING from another course; worked example lives in templates/README-template.md, not here>"
    ],
    "has_levelled_questions": "<true | false — ratified at the /hero-1-research entry gate, never assumed>",
    "skills_line_label": "<subject skills label, e.g. 'Mathematical skills' (sciences/maths), 'Source-analysis skills' (history)>",
    "no_skills_marker": "<the no-skills phrase research packs use internally, e.g. 'No mathematical skills for this spec point' — knowledge files OMIT the skills line for those SPs>"
  },
  "exemplars": [
    "<paths to 2 style exemplars max. A new course starts empty: the first wave's user-approved pilot files (/hero-2-write) become the exemplars>"
  ],
  "research_mode": "local",
  "research_mode_notes": "Mode switches R3 only — R1 (evidence assembly from stage-0 artifacts) and R2 (converted QP/MS corpus, discovery + extraction) run unconditionally in every mode. local = R3-local-check.md systematic ER sweep (default). hybrid = local first, NLM escalation when a subtopic's sweep returns <3 usable ER passages. nlm = R3-nlm-check.md (for courses whose ER corpus is missing or unconverted — QP/MS corpus still required). Notebook id lives in corpus.notebook_id, verified against the notebook itself via notebook_get.",
  "model_policy": {
    "research": "sonnet",
    "fixers": "sonnet",
    "upload": "sonnet",
    "writers": "opus",
    "checkers": "strongest available, never below Opus 5"
  },
  "quality_gates": {
    "fixer_diff_sweep": true,
    "sampled_reaudit_per_wave": "EVERY file on the course's first wave (F55 — the blind pass is the check while template/exemplars settle); 2-3 files risk-picked on waves 2+; always blind to the original checker-report AND to contested rulings (F57)",
    "preflight_sweep": "master mode pre-strip, --cobalt mode pre-upload",
    "upload_hold": "no upload until the user approves the wave sample"
  },
  "wave_size": "~15 subtopics (max 19)",
  "concurrency_cap": 20,
  "status": {
    "_comment": "Every stage skill writes its own completion back here as its FINAL act (F30) — a status nobody writes to goes stale while staying authoritative-by-declaration. /hero cross-checks this block against the wave-state grid and warns on disagreement. blockers lists every blocker knowingly left open; an empty array on a project with a live blocker reads as a checked negative.",
    "stage": "<0-setup | 1-research | 2-write | 3-check | 4-publish — coarse pointer; wave-state files carry the detail>",
    "units_complete": [],
    "docs_live": 0,
    "next_unit": 1,
    "blockers": []
  }
}
